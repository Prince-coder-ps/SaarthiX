# Copy to server/.env (server.js loads server/.env). NEVER commit the real .env.

PORT=5000
NODE_ENV=development

# MongoDB — local or Atlas
MONGO_URI=mongodb://localhost:27017/alumni_connect

# JWT — use a long random string (32+ chars)
JWT_SECRET=replace_this_with_a_very_long_random_secret_string
JWT_EXPIRES_IN=7d

# Production CORS origin (your frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# Default time zone for session date/time entered without a zone (IANA name)
APP_TIMEZONE=Asia/Kolkata

# ── Session reminder emails (Nodemailer / SMTP) ──────────────────────────
# Example: Brevo SMTP → EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587
# Example: Gmail     → EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587 (use an App Password)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="SaarthiX <no-reply@your-domain.com>"

# ── Reminder scheduler ───────────────────────────────────────────────────
# Set to "false" to disable the in-process scheduler (e.g. when using only the external trigger)
ENABLE_REMINDER_SCHEDULER=true
# Optional: enables POST /api/internal/reminders/run (header x-cron-secret) for hosts that sleep.
# Use a long random value. Leave empty to keep the endpoint disabled.
CRON_SECRET=
